{
  "name": "distributor/telegram-broadcast",
  "description": "Small multilingual Telegram broadcast service",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sqlite3": "*",
    "ext-zip": "*",
    "giggsey/libphonenumber-for-php": "^8.13",
    "openspout/openspout": "^4.23",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"Broadcast\\": "src/"}},
  "autoload-dev": {"psr-4": {"Broadcast\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "check": ["@test"]},
  "config": {"sort-packages": true, "platform": {"php": "8.4.0"}}
}
