# Copy to .env, fill locally. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Positive numeric Telegram IDs, comma separated without spaces.
TELEGRAM_ADMIN_IDS=123456789
DEEPL_API_KEY=
# API Free: https://api-free.deepl.com ; paid API: https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com
# Docker Compose overrides this with /data/broadcast.sqlite.
DATABASE_PATH=./var/broadcast.sqlite
